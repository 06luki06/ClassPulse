<Project>
  <!--
    Build rules for every project in this repository. See docs/decisions/0002-build-enforced-rules.md.
    Do not weaken these settings or add NoWarn to get a build passing; fix the cause instead.
  -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Vulnerability advisories change over time without any change in this repository, so they
      stay visible warnings instead of failing old commits. The CI audit step reports them.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
