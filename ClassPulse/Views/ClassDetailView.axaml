<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:At.luki0606.ClassPulse.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:res="clr-namespace:At.luki0606.ClassPulse.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="At.luki0606.ClassPulse.Views.ClassDetailView"
             x:DataType="vm:ClassDetailViewModel">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}" 
                Padding="16" 
                Margin="0,0,0,16" 
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                <Button Grid.Column="0" Command="{Binding BackToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="ArrowLeft" />
                        <TextBlock Text="{x:Static res:Resources.Label_Home}" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" 
                           Text="{Binding ClassTitle}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />

                <Button Grid.Column="2" 
                        Command="{Binding AddStudentCommand}" 
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="PersonAdd" />
                        <TextBlock Text="{x:Static res:Resources.Label_Pupil}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" 
                        Command="{Binding AddAssessmentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Add" />
                        <TextBlock Text="{x:Static res:Resources.Label_Test}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding AddSubjectCommand}"
                        Margin="8, 0, 0, 0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
						<ic:SymbolIcon Symbol="BookAdd"/>
                        <TextBlock Text="{x:Static res:Resources.Label_Subject}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StudentRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentMatrixRow">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto, Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Person" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding FullName}" 
                                                   FontSize="18" 
                                                   FontWeight="Bold" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" 
                                            Background="{DynamicResource PrimaryBrush}" 
                                            CornerRadius="6" 
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Static res:Resources.Label_Average}" Foreground="White" FontSize="12"/>
                                            <TextBlock Text="{Binding OverallAverage}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SubjectGradesList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SubjectGradeDto">
                                            <Border Background="#15000000" 
                                                    CornerRadius="6" 
                                                    Padding="8,4" 
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text=":" />
                                                    <TextBlock Text="{Binding Grade}" 
                                                               FontWeight="Bold" 
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               FontSize="13"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>