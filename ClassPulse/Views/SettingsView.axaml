<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:At.luki0606.ClassPulse.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:res="clr-namespace:At.luki0606.ClassPulse.Resources"
             x:Class="At.luki0606.ClassPulse.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}" 
                Padding="16" Margin="0,0,0,16" CornerRadius="8">
            <Grid ColumnDefinitions="Auto, *">
                <Button Grid.Column="0" Command="{Binding BackToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="ArrowLeft" />
                        <TextBlock Text="{x:Static res:Resources.Label_Home}" />
                    </StackPanel>
                </Button>   
                <TextBlock Grid.Column="1" Text="{x:Static res:Resources.Label_Settings}" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                Padding="24" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top" Width="400">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:Resources.Label_Theme}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}" 
                              SelectedItem="{Binding SelectedThemeOption}" 
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:Resources.Label_Language}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                              SelectedItem="{Binding SelectedLanguageOption}" 
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>